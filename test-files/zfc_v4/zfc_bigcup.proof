include "zfc_cup.proof"

definition predicate bigcup(X, Y) as \forall y (in(y, Y) \leftrightarrow \exists x (in(y, x) \wedge in(x, X)))

theorem bigcup_is_unique \forall X \forall Y \forall Y' (bigcup(X, Y) \wedge bigcup(X, Y') \to equal(Y, Y')) {
  any X, Y, Y' {
    assume bigcup(X, Y) \wedge bigcup(X, Y') {
      split bigcup(X, Y) \wedge bigcup(X, Y')
      expand bigcup(X, Y) for bigcup
      expand bigcup(X, Y') for bigcup
      connect \forall y (in(y, Y) \leftrightarrow \exists x (in(y, x) \wedge in(x, X))) \wedge \forall y (in(y, Y') \leftrightarrow \exists x (in(y, x) \wedge in(x, X)))
      apply invoke set_is_unique_for_predicate for \lambda^P y. \exists x (in(y, x) \wedge in(x, X)), Y, Y'
    }
  }
}

definition predicate functional(predicate \phi[2]) as \forall x \forall y \forall y' (\phi(x, y) \wedge \phi(x, y') \to equal(y, y'))

theorem bigcup_is_functional functional(bigcup) {
  assert bigcup_is_unique
  fold for functional conclude functional(bigcup)
}

theorem bigcup_subset \forall Y \forall Z \forall h (bigcup(Y, Z) \wedge in(h, Y) \to subset(h, Z)) {
  any Y, Z, h {
    assume bigcup(Y, Z) \wedge in(h, Y) {
      split bigcup(Y, Z) \wedge in(h, Y)
      any u {
        assume in(u, h) {
          connect in(u, h) \wedge in(h, Y)
          lift for h conclude \exists h (in(u, h) \wedge in(h, Y))
          apply invoke leftward bigcup(Y, Z) for u
        }
      }
      fold for subset conclude subset(h, Z)
    }
  }
}
