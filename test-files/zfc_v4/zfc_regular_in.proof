include "zfc_regular.proof"

theorem hirrefrel_is_irrefrel \forall x (hirrefrel(x, in) \to irrefrel(x, in)) {
  any x {
    assume hirrefrel(x, in) {
      some y such hirrefrel(x, in) {
        split irrefrel(y, in) \wedge tcset(x, in, y)
        fold for tcm conclude tcm(x, y)
        apply invoke tcm_implies_subset for x, y
        connect irrefrel(y, in) \wedge subset(x, y)
        apply invoke subset_of_irrefrel_is_irrefrel for in, y, x
      }
    }
  }
}

theorem set_of_hirrefrel_is_hirrefrel \forall Y (\forall y (in(y, Y) \to hirrefrel(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) \to hirrefrel(Y, in)) {
  any Y {
    assume \forall y (in(y, Y) \to hirrefrel(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) {
      split \forall y (in(y, Y) \to hirrefrel(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V))
      some Z, W, V such \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) {
        split tcmstep(Y, Z, W, V)
        apply invoke tcm_is_cup_of_itself_and_bigcup_of_tcm_of_element for Y, Z, W, V
        any y {
          assume in(y, Y) {
            apply invoke \forall y (in(y, Y) \to hirrefrel(y, in)) for y
            apply invoke hirrefrel_is_irrefrel for y
            apply invoke irrefrel_not_contain_itself for y
          }
        }
        fold for irrefrel conclude irrefrel(Y, in)
        any w {
          assume in(w, W) {
            apply invoke rightward bigcup(Z, W) for w
            some z such \exists z (in(w, z) \wedge in(z, Z)) {
              split in(w, z) \wedge in(z, Z)
              apply invoke rightward replacement(Y, tcm, Z) for z
              some y such \exists y (in(y, Y) \wedge tcm(y, z)) {
                split in(y, Y) \wedge tcm(y, z)
                apply invoke \forall y (in(y, Y) \to hirrefrel(y, in)) for y
                some z' such hirrefrel(y, in) {
                  split irrefrel(z', in) \wedge tcset(y, in, z')
                  fold for tcm conclude tcm(y, z')
                  connect tcm(y, z) \wedge tcm(y, z')
                  apply invoke tcm_is_unique for y, z, z'
                  substitute irrefrel(z', in) for z': z
                  apply invoke irrefrel(z, in) for w
                }
              }
            }
          }
        }
        fold for irrefrel conclude irrefrel(W, in)
        connect irrefrel(Y, in) \wedge irrefrel(W, in) \wedge cup(Y, W, V)
        apply invoke cup_of_irrefrel_is_irrefrel for in, Y, W, V
        expand tcm(Y, V) for tcm
        connect irrefrel(V, in) \wedge tcset(Y, in, V)
        lift for V conclude hirrefrel(Y, in)
      }
    }
  }
}

theorem hwellfounded_is_wellfounded \forall x (hwellfounded(x, in) \to wellfounded(x, in)) {
  any x {
    assume hwellfounded(x, in) {
      some y such hwellfounded(x, in) {
        split wellfounded(y, in) \wedge tcset(x, in, y)
        fold for tcm conclude tcm(x, y)
        apply invoke tcm_implies_subset for x, y
        connect wellfounded(y, in) \wedge subset(x, y)
        apply invoke subset_of_wellfounded_is_wellfounded for in, y, x
      }
    }
  }
}

theorem set_of_hwellfounded_is_hwellfounded \forall Y (\forall y (in(y, Y) \to hwellfounded(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) \to hwellfounded(Y, in)) {
  any Y {
    assume \forall y (in(y, Y) \to hwellfounded(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) {
      split \forall y (in(y, Y) \to hwellfounded(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V))
      some Z, W, V such \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) {
        split tcmstep(Y, Z, W, V)
        apply invoke tcm_is_cup_of_itself_and_bigcup_of_tcm_of_element for Y, Z, W, V
        any A {
          assume subset(A, V) \wedge neq(A, emptyset) {
            split subset(A, V) \wedge neq(A, emptyset)
            apply invoke not_emptyset_has_a_member for A
            some v such \exists v (in(v, A)) {
              apply invoke subset(A, V) for v
              apply invoke rightward cup(Y, W, V) for v
              divide in(v, Y) \vee in(v, W)
                case in(v, Y) {
                  apply invoke \forall y (in(y, Y) \to hwellfounded(y, in)) for v
                }
                case in(v, W) {
                  apply invoke rightward bigcup(Z, W) for v
                  some z such \exists z (in(v, z) \wedge in(z, Z)) {
                    split in(v, z) \wedge in(z, Z)
                    apply invoke rightward replacement(Y, tcm, Z) for z
                    some y such \exists y (in(y, Y) \wedge tcm(y, z)) {
                      split in(y, Y) \wedge tcm(y, z)
                      apply invoke \forall y (in(y, Y) \to hwellfounded(y, in)) for y
                      some z' such hwellfounded(y, in) {
                        split wellfounded(z', in) \wedge tcset(y, in, z')
                        fold for tcm conclude tcm(y, z')
                        apply invoke tcm_is_tcm_of_itself for y, z'
                        expand tcm(z', z') for tcm
                        connect wellfounded(z', in) \wedge tcset(z', in, z')
                        lift for z' conclude hwellfounded(z', in)
                        connect tcm(y, z) \wedge tcm(y, z')
                        apply invoke tcm_is_unique for y, z, z'
                        substitute hwellfounded(z', in) for z': z
                        connect hwellfounded(z, in) \wedge in(v, z)
                        apply invoke element_of_hwellfounded_is_hwellfounded for z, in, v
                      }
                    }
                  }
                }
              some T such hwellfounded(v, in) {
                split wellfounded(T, in) \wedge tcset(v, in, T)
                fold for tcm conclude tcm(v, T)
                apply invoke tcm_implies_subset for v, T
                expand tcm(v, T) for tcm
                split tcset(v, in, T)
                apply law_of_excluded_middle for \lambda^P. equal(cap(A, T), emptyset)
                divide equal(cap(A, T), emptyset) \vee neq(cap(A, T), emptyset)
                  case equal(cap(A, T), emptyset) {
                    any x {
                      assume in(x, A) \wedge neq(x, v) {
                        split in(x, A) \wedge neq(x, v)
                        deny in(x, v) {
                          apply invoke subset(v, T) for x
                          connect in(x, A) \wedge in(x, T)
                          apply invoke leftward cap_characterization for A, T, x
                          substitute in(x, cap(A, T)) for cap(A, T): emptyset
                          apply emptyset_existence for x
                          contradict in(x, emptyset)
                        }
                      }
                    }
                    fold for minimal_core conclude minimal_core(in, A, v)
                    connect minimal(in, A, v)
                    lift for v conclude \exists a (minimal(in, A, a))
                  }
                  case neq(cap(A, T), emptyset) {
                    apply cap_is_subset_right for A, T
                    connect subset(cap(A, T), T) \wedge neq(cap(A, T), emptyset)
                    apply invoke wellfounded(T, in) for cap(A, T)
                    some a such \exists a (minimal(in, cap(A, T), a)) {
                      split minimal(in, cap(A, T), a)
                      apply invoke rightward cap_characterization for A, T, a
                      split in(a, A) \wedge in(a, T)
                      any x {
                        assume in(x, A) \wedge neq(x, a) {
                          split in(x, A) \wedge neq(x, a)
                          deny in(x, a) {
                            connect in(x, a) \wedge in(a, T)
                            apply invoke leftward trans_iff_closed_in for T
                            apply invoke trans(T) for a, x
                            connect in(x, A) \wedge in(x, T)
                            apply invoke leftward cap_characterization for A, T, x
                            connect in(x, cap(A, T)) \wedge neq(x, a)
                            apply invoke minimal_core(in, cap(A, T), a) for x
                            contradict in(x, a)
                          }
                        }
                      }
                      fold for minimal_core conclude minimal_core(in, A, a)
                      connect minimal(in, A, a)
                      lift for a conclude \exists a (minimal(in, A, a))
                    }
                  }
              }
            }
          }
        }
        fold for wellfounded conclude wellfounded(V, in)
        expand tcm(Y, V) for tcm
        connect wellfounded(V, in) \wedge tcset(Y, in, V)
        lift for V conclude hwellfounded(Y, in)
      }
    }
  }
}

theorem regular_is_irrefrel_wellfounded \forall x (regular(x, in) \to irrefrel(x, in) \wedge wellfounded(x, in)) {
  any x {
    assume regular(x, in) {
      split regular(x, in)
      apply invoke hirrefrel_is_irrefrel for x
      apply invoke hwellfounded_is_wellfounded for x
      connect irrefrel(x, in) \wedge wellfounded(x, in)
    }
  }
}

theorem set_of_regular_is_regular \forall Y (\forall y (in(y, Y) \to regular(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) \to regular(Y, in)) {
  any Y {
    assume \forall y (in(y, Y) \to regular(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V)) {
      split \forall y (in(y, Y) \to regular(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V))
      any y {
        assume in(y, Y) {
          apply invoke \forall y (in(y, Y) \to regular(y, in)) for y
          split 1 regular(y, in)
        }
      }
      connect \forall y (in(y, Y) \to hirrefrel(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V))
      apply invoke set_of_hirrefrel_is_hirrefrel for Y
      any y {
        assume in(y, Y) {
          apply invoke \forall y (in(y, Y) \to regular(y, in)) for y
          split 2 regular(y, in)
        }
      }
      connect \forall y (in(y, Y) \to hwellfounded(y, in)) \wedge \exists Z \exists W \exists V (tcmstep(Y, Z, W, V))
      apply invoke set_of_hwellfounded_is_hwellfounded for Y
      connect regular(Y, in)
    }
  }
}

theorem regular_satisfies_axiom_of_extensionality \forall x \forall y (regular(x, in) \wedge regular(y, in) \to (\forall z (regular(z, in) \to (in(z, x) \leftrightarrow in(z, y))) \to equal(x, y))) {
  any x, y {
    assume regular(x, in) \wedge regular(y, in) {
      split regular(x, in) \wedge regular(y, in)
      assume \forall z (regular(z, in) \to (in(z, x) \leftrightarrow in(z, y))) {
        any z {
          assume in(z, x) {
            connect regular(x, in) \wedge in(z, x)
            apply invoke element_of_regular_is_regular for x, in, z
            apply invoke \forall z (regular(z, in) \to (in(z, x) \leftrightarrow in(z, y))) for z
            invoke rightward in(z, x) \leftrightarrow in(z, y)
          }
          assume in(z, y) {
            connect regular(y, in) \wedge in(z, y)
            apply invoke element_of_regular_is_regular for y, in, z
            apply invoke \forall z (regular(z, in) \to (in(z, x) \leftrightarrow in(z, y))) for z
            invoke leftward in(z, x) \leftrightarrow in(z, y)
          }
          connect in(z, x) \leftrightarrow in(z, y)
        }
        apply invoke axiom_of_extensionality for x, y
      }
    }
  }
}

theorem emptyset_is_regular regular(emptyset, in) {
  assert emptyset_is_tcm_of_emptyset
  expand tcm(emptyset, emptyset) for tcm
  assert emptyset_is_irrefrel
  connect irrefrel(emptyset, in) \wedge tcset(emptyset, in, emptyset)
  lift for emptyset conclude hirrefrel(emptyset, in)
  assert emptyset_is_wellfounded
  connect wellfounded(emptyset, in) \wedge tcset(emptyset, in, emptyset)
  lift for emptyset conclude hwellfounded(emptyset, in)
  connect regular(emptyset, in)
}

theorem regular_satisfies_axiom_of_emptyset \exists x (regular(x, in) \wedge \forall y (regular(y, in) \to notin(y, x))) {
  assert emptyset_is_regular
  any y {
    assume regular(y, in) {
      apply emptyset_existence for y
    }
  }
  connect regular(emptyset, in) \wedge \forall y (regular(y, in) \to notin(y, emptyset))
  lift for emptyset conclude \exists x (regular(x, in) \wedge \forall y (regular(y, in) \to notin(y, x)))
}

theorem regular_satisfies_axiom_of_separation \forall^P \phi[1] \forall x (regular(x, in) \to \exists y (regular(y, in) \wedge \forall z (regular(z, in) \to (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z))))) {
  any predicate \phi[1], x {
    assume regular(x, in) {
      apply invoke rightward regular_iff_existence_of_irrefrel_wellfounded_tcset for x, in
      some p such \exists p (irrefrel(p, in) \wedge wellfounded(p, in) \wedge tcset(x, in, p)) {
        split irrefrel(p, in) \wedge wellfounded(p, in) \wedge tcset(x, in, p)
        split tcset(x, in, p)
        apply axiom_of_separation for x, \phi
        some y such \exists y \forall z (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z)) {
          apply axiom_of_separation for p, \lambda^P z. \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))
          some q such \exists q \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) {
            any u, v {
              assume in(u, q) \wedge in(v, u) {
                split in(u, q) \wedge in(v, u)
                apply invoke rightward \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) for u
                split in(u, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(u, s))
                connect in(u, p) \wedge in(v, u)
                apply invoke closed(p, in) for u, v
                any s {
                  assume closed(s, in) \wedge subset(y, s) {
                    split closed(s, in) \wedge subset(y, s)
                    apply invoke \forall s (closed(s, in) \wedge subset(y, s) \to in(u, s)) for s
                    connect in(u, s) \wedge in(v, u)
                    apply invoke closed(s, in) for u, v
                  }
                }
                connect in(v, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(v, s))
                apply invoke leftward \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) for v
              }
            }
            fold for closed conclude closed(q, in)
            any w {
              assume in(w, y) {
                apply invoke rightward \forall z (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z)) for w
                split in(w, x) \wedge \phi(w)
                apply invoke \forall w (in(w, x) \to in(w, p)) for w
                any s {
                  assume closed(s, in) \wedge subset(y, s) {
                    split 2 closed(s, in) \wedge subset(y, s)
                    apply invoke subset(y, s) for w
                  }
                }
                connect in(w, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(w, s))
                apply invoke leftward \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) for w
              }
            }
            any s {
              assume closed(s, in) \wedge \forall z (in(z, y) \to in(z, s)) {
                split closed(s, in) \wedge \forall z (in(z, y) \to in(z, s))
                fold for subset conclude subset(y, s)
                connect closed(s, in) \wedge subset(y, s)
                any z {
                  assume in(z, q) {
                    apply invoke rightward \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) for z
                    split in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))
                    apply invoke \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s)) for s
                  }
                }
                fold for subset conclude subset(q, s)
              }
            }
            connect tcset(y, in, q)
            fold for tcm conclude tcm(y, q)
            any z {
              assume in(z, q) {
                apply invoke rightward \forall z (in(z, q) \leftrightarrow in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))) for z
                split 1 in(z, p) \wedge \forall s (closed(s, in) \wedge subset(y, s) \to in(z, s))
              }
            }
            fold for subset conclude subset(q, p)
            connect irrefrel(p, in) \wedge subset(q, p)
            apply invoke subset_of_irrefrel_is_irrefrel for in, p, q
            connect wellfounded(p, in) \wedge subset(q, p)
            apply invoke subset_of_wellfounded_is_wellfounded for in, p, q
            connect irrefrel(q, in) \wedge wellfounded(q, in) \wedge tcset(y, in, q)
            lift for q conclude \exists q (irrefrel(q, in) \wedge wellfounded(q, in) \wedge tcset(y, in, q))
          }
          apply invoke leftward regular_iff_existence_of_irrefrel_wellfounded_tcset for y, in
          any z {
            assume regular(z, in) {
              apply \forall z (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z)) for z
            }
          }
          connect regular(y, in) \wedge \forall z (regular(z, in) \to (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z)))
          lift for y conclude \exists y (regular(y, in) \wedge \forall z (regular(z, in) \to (in(z, y) \leftrightarrow in(z, x) \wedge \phi(z))))
        }
      }
    }
  }
}

theorem regular_satisfies_axiom_of_foundation \forall x (regular(x, in) \to (neq(x, emptyset) \to \exists y (regular(y, in) \wedge in(y, x) \wedge \forall z (regular(z, in) \to (in(z, y) \to notin(z, x)))))) {
  any A {
    assume regular(A, in) {
      assume neq(A, emptyset) {
        split regular(A, in)
        apply invoke hirrefrel_is_irrefrel for A
        apply invoke hwellfounded_is_wellfounded for A
        apply subset_reflexivity for A
        connect subset(A, A) \wedge neq(A, emptyset)
        apply invoke wellfounded(A, in) for A
        some y such \exists y (minimal(in, A, y)) {
          split minimal(in, A, y)
          connect regular(A, in) \wedge in(y, A)
          apply invoke element_of_regular_is_regular for A, in, y
          any z {
            assume regular(z, in) {
              assume in(z, y) {
                deny in(z, A) {
                  apply law_of_excluded_middle for \lambda^P. equal(z, y)
                  divide equal(z, y) \vee neq(z, y)
                    case equal(z, y) {
                      substitute in(z, y) for z: y
                      apply invoke irrefrel(A, in) for y
                      contradict in(y, y)
                    }
                    case neq(z, y) {
                      connect in(z, A) \wedge neq(z, y)
                      apply invoke minimal_core(in, A, y) for z
                      contradict in(z, y)
                    }
                }
              }
            }
          }
          connect regular(y, in) \wedge in(y, A) \wedge \forall z (regular(z, in) \to (in(z, y) \to notin(z, A)))
          lift for y conclude \exists y (regular(y, in) \wedge in(y, A) \wedge \forall z (regular(z, in) \to (in(z, y) \to notin(z, A))))
        }
      }
    }
  }
}

theorem regular_implies_tcm_is_regular \forall x \forall t (regular(x, in) \wedge tcset(x, in, t) \to regular(t, in)) {
  any x, t {
    assume regular(x, in) \wedge tcset(x, in, t) {
      split regular(x, in) \wedge tcset(x, in, t)
      apply invoke rightward regular_iff_existence_of_irrefrel_wellfounded_tcset for x, in
      some t' such \exists t' (irrefrel(t', in) \wedge wellfounded(t', in) \wedge tcset(x, in, t')) {
        split irrefrel(t', in) \wedge wellfounded(t', in) \wedge tcset(x, in, t')
        connect tcset(x, in, t) \wedge tcset(x, in, t')
        apply invoke tcset_is_unique for x, in, t, t'
        substitute irrefrel(t', in) for t': t
        substitute wellfounded(t', in) for t': t
        split tcset(x, in, t)
        apply invoke rightward closed_in_iff_tcset_of_itself for t
        connect irrefrel(t, in) \wedge wellfounded(t, in) \wedge tcset(t, in, t)
        lift for t conclude \exists t' (irrefrel(t', in) \wedge wellfounded(t', in) \wedge tcset(t, in, t'))
      }
      apply invoke leftward regular_iff_existence_of_irrefrel_wellfounded_tcset for t, in
    }
  }
}
