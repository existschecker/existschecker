include "zfc_finite.proof"

theorem finite_approx_exists \forall X \forall^P \psi[2] \forall^P \phi[2] (closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge finite(X) \wedge functional(\phi) \wedge \forall p \exists q (\phi(p, q)) \to \forall x (in(x, X) \to \exists h (finite(h) \wedge approx(\psi, \phi, x, h)))) {
  any X, predicate \psi[2], predicate \phi[2] {
    assume closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge finite(X) \wedge functional(\phi) \wedge \forall p \exists q (\phi(p, q)) {
      split closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge finite(X) \wedge functional(\phi) \wedge \forall p \exists q (\phi(p, q))
      any x {
        assume in(x, X) {
          connect closed(X, \psi) \wedge in(x, X)
          apply invoke closed_implies_rtcset_exists for X, \psi, x
          some r such \exists r (rtcset(x, \psi, r) \wedge subset(r, X)) {
            split rtcset(x, \psi, r) \wedge subset(r, X)
            split rtcset(x, \psi, r)
            assume \forall y (\psi(y, x) \to \exists h (finite(h) \wedge approx(\psi, \phi, y, h))) {
              apply invoke closed_implies_seg_exists for X, \psi, x
              apply sep_is_subset for X, \lambda^P y. \psi(y, x)
              connect finite(X) \wedge subset(sep(X, \lambda^P y. \psi(y, x)), X)
              apply invoke subset_of_finite_is_finite for X, sep(X, \lambda^P y. \psi(y, x))
              connect closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi)
              apply invoke approx_is_functional for X, \psi, \phi
              connect finite(sep(X, \lambda^P y. \psi(y, x))) \wedge functional(\lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h))
              apply invoke finite_replacement_exists_uniquely for sep(X, \lambda^P y. \psi(y, x)), \lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h)
              some Y such \exists! Y (finite(Y) \wedge replacement(sep(X, \lambda^P y. \psi(y, x)), \lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h), Y)) {
                split finite(Y) \wedge replacement(sep(X, \lambda^P y. \psi(y, x)), \lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h), Y)
                any y {
                  assume in(y, Y) {
                    apply invoke rightward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for y
                    some z such \exists z (in(z, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(z, X) \wedge approx(\psi, \phi, z, y)) {
                      split in(z, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(z, X) \wedge approx(\psi, \phi, z, y)
                      split approx(\psi, \phi, z, y)
                      some t such \exists t (dom(y, t) \wedge rtcset(z, \psi, t) \wedge \forall u \forall v (in(op(u, v), y) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(y, s)), v)))) {
                        split dom(y, t) \wedge rtcset(z, \psi, t) \wedge \forall u \forall v (in(op(u, v), y) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(y, s)), v)))
                        connect closed(X, \psi) \wedge in(z, X) \wedge rtcset(z, \psi, t)
                        apply invoke closed_implies_rtcset_is_subset for X, \psi, z, t
                        connect finite(X) \wedge subset(t, X)
                        apply invoke subset_of_finite_is_finite for X, t
                        connect fun(y) \wedge dom(y, t) \wedge finite(t)
                        apply invoke dom_finite_implies_fun_finite for y, t
                      }
                    }
                  }
                }
                connect finite(Y) \wedge \forall y (in(y, Y) \to finite(y))
                apply invoke finite_bigcup_exists_uniquely for Y
                some Z such \exists! Z (finite(Z) \wedge bigcup(Y, Z)) {
                  split finite(Z) \wedge bigcup(Y, Z)
                  apply invoke closed_implies_seg_exists for X, \psi, x
                  apply \forall p \exists q (\phi(p, q)) for op(x, res(Z, sep(X, \lambda^P y. \psi(y, x))))
                  some q such \exists q (\phi(op(x, res(Z, sep(X, \lambda^P y. \psi(y, x)))), q)) {
                    apply invoke finite_adj for Z, op(x, q)
                    any z {
                      assume in(z, Z) {
                        apply invoke rightward bigcup(Y, Z) for z
                        some y such \exists y (in(z, y) \wedge in(y, Y)) {
                          split in(z, y) \wedge in(y, Y)
                          apply invoke rightward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for y
                          some w such \exists w (in(w, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)) {
                            split in(w, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)
                            split approx(\psi, \phi, w, y)
                            split fun(y)
                            apply invoke rel(y) for z
                          }
                        }
                      }
                    }
                    fold for rel conclude rel(Z)
                    any u, v, v' {
                      assume in(op(u, v), Z) \wedge in(op(u, v'), Z) {
                        split in(op(u, v), Z) \wedge in(op(u, v'), Z)
                        apply invoke rightward bigcup(Y, Z) for op(u, v)
                        some y such \exists y (in(op(u, v), y) \wedge in(y, Y)) {
                          split in(op(u, v), y) \wedge in(y, Y)
                          apply invoke rightward replacement(sep(X, \lambda^P z. \psi(z, x)), \lambda^P z, h. in(z, X) \wedge approx(\psi, \phi, z, h), Y) for y
                          some w such \exists w (in(w, sep(X, \lambda^P z. \psi(z, x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)) {
                            split in(w, sep(X, \lambda^P z. \psi(z, x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)
                            apply invoke rightward bigcup(Y, Z) for op(u, v')
                            some y' such \exists y' (in(op(u, v'), y') \wedge in(y', Y)) {
                              split in(op(u, v'), y') \wedge in(y', Y)
                              apply invoke rightward replacement(sep(X, \lambda^P z. \psi(z, x)), \lambda^P z, h. in(z, X) \wedge approx(\psi, \phi, z, h), Y) for y'
                              some w' such \exists w' (in(w', sep(X, \lambda^P z. \psi(z, x))) \wedge in(w', X) \wedge approx(\psi, \phi, w', y')) {
                                split in(w', sep(X, \lambda^P z. \psi(z, x))) \wedge in(w', X) \wedge approx(\psi, \phi, w', y')
                                connect in(w, X) \wedge approx(\psi, \phi, w, y) \wedge in(w', X) \wedge approx(\psi, \phi, w', y')
                                apply invoke approx_is_unique for X, \psi, \phi
                                apply invoke \forall x \forall y \forall g \forall h (in(x, X) \wedge approx(\psi, \phi, x, g) \wedge in(y, X) \wedge approx(\psi, \phi, y, h) \to \forall u \forall v \forall v' (in(op(u, v), g) \wedge in(op(u, v'), h) \to equal(v, v'))) for w, w', y, y'
                                connect in(op(u, v), y) \wedge in(op(u, v'), y')
                                apply invoke \forall u \forall v \forall v' (in(op(u, v), y) \wedge in(op(u, v'), y') \to equal(v, v')) for u, v, v'
                              }
                            }
                          }
                        }
                      }
                    }
                    connect fun(Z)
                    deny \exists b (in(op(x, b), Z)) {
                      some b such \exists b (in(op(x, b), Z)) {
                        apply invoke rightward bigcup(Y, Z) for op(x, b)
                        some y such \exists y (in(op(x, b), y) \wedge in(y, Y)) {
                          split in(op(x, b), y) \wedge in(y, Y)
                          apply invoke rightward replacement(sep(X, \lambda^P z. \psi(z, x)), \lambda^P z, h. in(z, X) \wedge approx(\psi, \phi, z, h), Y) for y
                          some w such \exists w (in(w, sep(X, \lambda^P z. \psi(z, x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)) {
                            split in(w, sep(X, \lambda^P z. \psi(z, x))) \wedge in(w, X) \wedge approx(\psi, \phi, w, y)
                            apply invoke rightward sep_existence for X, \lambda^P z. \psi(z, x), w
                            split in(w, X) \wedge \psi(w, x)
                            split approx(\psi, \phi, w, y)
                            some t such \exists t (dom(y, t) \wedge rtcset(w, \psi, t) \wedge \forall u \forall v (in(op(u, v), y) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(y, s)), v)))) {
                              split dom(y, t) \wedge rtcset(w, \psi, t) \wedge \forall u \forall v (in(op(u, v), y) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(y, s)), v)))
                              lift for b conclude \exists b (in(op(x, b), y))
                              apply invoke leftward dom(y, t) for x
                              connect closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi)
                              apply invoke rtcset_future_exclusion for X, \psi
                              connect in(x, X) \wedge \psi(w, x) \wedge rtcset(w, \psi, t)
                              apply invoke \forall x_0 \forall z_0 \forall r_0 (in(x_0, X) \wedge \psi(z_0, x_0) \wedge rtcset(z_0, \psi, r_0) \to notin(x_0, r_0)) for x, w, t
                              contradict in(x, t)
                            }
                          }
                        }
                      }
                    }
                    connect fun(Z) \wedge \neg(\exists b (in(op(x, b), Z)))
                    apply invoke adding_op_fun for Z, x, q
                    any u {
                      assume in(u, r) {
                        connect rtcset(x, \psi, r) \wedge in(u, r)
                        apply invoke rtcset_one_step for \psi, x, r, u
                        divide equal(u, x) \vee \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t))
                          case equal(u, x) {
                            apply adj_cor3 for Z, op(x, q)
                            lift for q conclude \exists v (in(op(x, v), adj(Z, op(x, q))))
                            substitute \exists v (in(op(x, v), adj(Z, op(x, q)))) for x[1]: u
                          }
                          case \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)) {
                            some y, t such \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)) {
                              split \psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)
                              connect in(x, X) \wedge \psi(y, x)
                              apply invoke closed(X, \psi) for x, y
                              connect in(y, X) \wedge \psi(y, x)
                              apply invoke leftward sep_existence for X, \lambda^P y'. \psi(y', x), y
                              apply invoke \forall y (\psi(y, x) \to \exists h (finite(h) \wedge approx(\psi, \phi, y, h))) for y
                              some h such \exists h (finite(h) \wedge approx(\psi, \phi, y, h)) {
                                split finite(h) \wedge approx(\psi, \phi, y, h)
                                connect in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)
                                lift for y conclude \exists y (in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h))
                                apply invoke leftward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for h
                                split approx(\psi, \phi, y, h)
                                some t' such \exists t' (dom(h, t') \wedge rtcset(y, \psi, t') \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t') \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))) {
                                  split dom(h, t') \wedge rtcset(y, \psi, t') \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t') \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))
                                  connect rtcset(y, \psi, t) \wedge rtcset(y, \psi, t')
                                  apply invoke rtcset_is_unique for y, \psi, t, t'
                                  substitute dom(h, t') for t': t
                                }
                                apply invoke rightward dom(h, t) for u
                                some v such \exists v (in(op(u, v), h)) {
                                  connect in(op(u, v), h) \wedge in(h, Y)
                                  lift for h conclude \exists h (in(op(u, v), h) \wedge in(h, Y))
                                  apply invoke leftward bigcup(Y, Z) for op(u, v)
                                  apply invoke adj_cor1 for Z, op(x, q), op(u, v)
                                  lift for v conclude \exists v (in(op(u, v), adj(Z, op(x, q))))
                                }
                              }
                            }
                          }
                      }
                      assume \exists v (in(op(u, v), adj(Z, op(x, q)))) {
                        some v such \exists v (in(op(u, v), adj(Z, op(x, q)))) {
                          apply invoke rightward adj_existence for Z, op(x, q), op(u, v)
                          divide in(op(u, v), Z) \vee equal(op(u, v), op(x, q))
                            case in(op(u, v), Z) {
                              apply invoke rightward bigcup(Y, Z) for op(u, v)
                              some h such \exists h (in(op(u, v), h) \wedge in(h, Y)) {
                                split in(op(u, v), h) \wedge in(h, Y)
                                apply invoke rightward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for h
                                some y such \exists y (in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)) {
                                  split in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)
                                  apply invoke sep_satisfies_predicate for X, \lambda^P y'. \psi(y', x), y
                                  split approx(\psi, \phi, y, h)
                                  some t such \exists t (dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))) {
                                    split dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))
                                    lift for v conclude \exists v (in(op(u, v), h))
                                    apply invoke leftward dom(h, t) for u
                                    connect in(x, r) \wedge \psi(y, x)
                                    apply invoke closed(r, \psi) for x, y
                                    connect closed(r, \psi) \wedge in(y, r) \wedge rtcset(y, \psi, t)
                                    apply invoke closed_implies_rtcset_is_subset for r, \psi, y, t
                                    apply invoke subset(t, r) for u
                                  }
                                }
                              }
                            }
                            case equal(op(u, v), op(x, q)) {
                              apply invoke op_characterization for u, v, x, q
                              split 1 equal(u, x) \wedge equal(v, q)
                              substitute in(x, r) for x: u
                            }
                        }
                      }
                      connect in(u, r) \leftrightarrow \exists v (in(op(u, v), adj(Z, op(x, q))))
                    }
                    fold for dom conclude dom(adj(Z, op(x, q)), r)
                    any u, v {
                      assume in(op(u, v), adj(Z, op(x, q))) {
                        lift for v conclude \exists v (in(op(u, v), adj(Z, op(x, q))))
                        apply invoke leftward dom(adj(Z, op(x, q)), r) for u
                        apply invoke rightward adj_existence for Z, op(x, q), op(u, v)
                        divide in(op(u, v), Z) \vee equal(op(u, v), op(x, q))
                          case in(op(u, v), Z) {
                            apply invoke rightward bigcup(Y, Z) for op(u, v)
                            some h such \exists h (in(op(u, v), h) \wedge in(h, Y)) {
                              split in(op(u, v), h) \wedge in(h, Y)
                              apply invoke rightward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for h
                              some y such \exists y (in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)) {
                                split in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)
                                apply invoke rightward sep_existence for X, \lambda^P y'. \psi(y', x), y
                                split in(y, X) \wedge \psi(y, x)
                                split approx(\psi, \phi, y, h)
                                some t such \exists t (dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))) {
                                  split dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))
                                  split rtcset(y, \psi, t)
                                  apply invoke rightward \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v))) for u, v
                                  split in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v))
                                  some s such \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)) {
                                    split seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)
                                    deny in(x, s) {
                                      apply invoke rightward seg(u, \psi, s) for x
                                      connect in(u, t) \wedge \psi(x, u)
                                      apply invoke closed(t, \psi) for u, x
                                      connect rtcset(y, \psi, t) \wedge in(u, t) \wedge \psi(x, u)
                                      connect closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi)
                                      apply invoke rtcset_future_exclusion for X, \psi
                                      connect in(x, X) \wedge \psi(y, x) \wedge rtcset(y, \psi, t)
                                      apply invoke \forall x \forall z \forall r (in(x, X) \wedge \psi(z, x) \wedge rtcset(z, \psi, r) \to notin(x, r)) for x, y, t
                                      contradict in(x, t)
                                    }
                                    apply invoke adding_op_res for Z, s, x, q
                                    connect bigcup(Y, Z) \wedge in(h, Y)
                                    apply invoke bigcup_subset for Y, Z, h
                                    connect closed(t, \psi) \wedge in(u, t) \wedge seg(u, \psi, s)
                                    apply invoke closed_implies_seg_is_subset for y, \psi, t, u, s
                                    connect fun(h) \wedge fun(Z) \wedge subset(h, Z) \wedge dom(h, t) \wedge subset(s, t)
                                    apply invoke res_subset_equality for h, Z, t, s
                                    substitute \phi(op(u, res(h, s)), v) for res(h, s): res(Z, s)
                                    substitute \phi(op(u, res(Z, s)), v) for res(Z, s): res(adj(Z, op(x, q)), s)
                                    connect seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v)
                                    lift for s conclude \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v))
                                  }
                                }
                              }
                            }
                          }
                          case equal(op(u, v), op(x, q)) {
                            apply invoke op_characterization for u, v, x, q
                            split equal(u, x) \wedge equal(v, q)
                            deny in(x, sep(X, \lambda^P y. \psi(y, x))) {
                              apply invoke sep_satisfies_predicate for X, \lambda^P y. \psi(y, x), x
                              apply invoke irrefrel(X, \psi) for x
                              contradict \neg(\psi(x, x))
                            }
                            apply invoke adding_op_res for Z, sep(X, \lambda^P y. \psi(y, x)), x, q
                            substitute \phi(op(x, res(Z, sep(X, \lambda^P y. \psi(y, x)))), q) for res(Z, sep(X, \lambda^P y. \psi(y, x))): res(adj(Z, op(x, q)), sep(X, \lambda^P y'. \psi(y', x)))
                            connect seg(x, \psi, sep(X, \lambda^P y. \psi(y, x))) \wedge \phi(op(x, res(adj(Z, op(x, q)), sep(X, \lambda^P y. \psi(y, x)))), q)
                            lift for sep(X, \lambda^P y. \psi(y, x)) conclude \exists s (seg(x, \psi, s) \wedge \phi(op(x, res(adj(Z, op(x, q)), s)), q))
                            substitute \exists s (seg(x, \psi, s) \wedge \phi(op(x, res(adj(Z, op(x, q)), s)), q)) for x[1, 2]: u, q[2]: v
                          }
                        connect in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v))
                      }
                      assume in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v)) {
                        split in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v))
                        some s such \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v)) {
                          split seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v)
                          connect rtcset(x, \psi, r) \wedge in(u, r)
                          apply invoke rtcset_one_step for \psi, x, r, u
                          divide equal(u, x) \vee \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t))
                            case equal(u, x) {
                              substitute \phi(op(u, res(adj(Z, op(x, q)), s)), v) for u: x
                              substitute seg(u, \psi, s) for u: x
                              deny in(x, s) {
                                apply invoke rightward seg(x, \psi, s) for x
                                apply invoke irrefrel(X, \psi) for x
                                contradict \psi(x, x)
                              }
                              apply invoke adding_op_res for Z, s, x, q
                              substitute \phi(op(u, res(adj(Z, op(x, q)), s)), v) for res(adj(Z, op(x, q)), s): res(Z, s)
                              apply invoke closed_implies_seg_exists for X, \psi, x
                              connect seg(x, \psi, s) \wedge seg(x, \psi, sep(X, \lambda^P y. \psi(y, x)))
                              apply invoke seg_is_unique for x, \psi, s, sep(X, \lambda^P y. \psi(y, x))
                              substitute \phi(op(x, res(Z, sep(X, \lambda^P y. \psi(y, x)))), q) for sep(X, \lambda^P y. \psi(y, x)): s
                              substitute \phi(op(u, res(Z, s)), v) for u: x
                              apply adj_cor3 for Z, op(x, q)
                              connect \phi(op(x, res(Z, s)), v) \wedge \phi(op(x, res(Z, s)), q)
                              apply invoke functional(\phi) for op(x, res(Z, s)), v, q
                              substitute in(op(x, q), adj(Z, op(x, q))) for x[1]: u, q[1]: v
                            }
                            case \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)) {
                              some y, t such \exists y \exists t (\psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)) {
                                split \psi(y, x) \wedge rtcset(y, \psi, t) \wedge in(u, t)
                                split rtcset(y, \psi, t)
                                connect in(x, X) \wedge \psi(y, x)
                                apply invoke closed(X, \psi) for x, y
                                connect in(y, X) \wedge \psi(y, x)
                                apply invoke leftward sep_existence for X, \lambda^P y'. \psi(y', x), y
                                apply invoke \forall y (\psi(y, x) \to \exists h (finite(h) \wedge approx(\psi, \phi, y, h))) for y
                                some h such \exists h (finite(h) \wedge approx(\psi, \phi, y, h)) {
                                  split finite(h) \wedge approx(\psi, \phi, y, h)
                                  connect in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)
                                  lift for y conclude \exists y (in(y, sep(X, \lambda^P y'. \psi(y', x))) \wedge in(y, X) \wedge approx(\psi, \phi, y, h))
                                  apply invoke leftward replacement(sep(X, \lambda^P y'. \psi(y', x)), \lambda^P y', h. in(y', X) \wedge approx(\psi, \phi, y', h), Y) for h
                                  split approx(\psi, \phi, y, h)
                                  some t' such \exists t' (dom(h, t') \wedge rtcset(y, \psi, t') \wedge \forall u' \forall v' (in(op(u', v'), h) \leftrightarrow in(u', t') \wedge \exists s' (seg(u', \psi, s') \wedge \phi(op(u', res(h, s')), v')))) {
                                    split dom(h, t') \wedge rtcset(y, \psi, t') \wedge \forall u' \forall v' (in(op(u', v'), h) \leftrightarrow in(u', t') \wedge \exists s' (seg(u', \psi, s') \wedge \phi(op(u', res(h, s')), v')))
                                    connect rtcset(y, \psi, t) \wedge rtcset(y, \psi, t')
                                    apply invoke rtcset_is_unique for y, \psi, t, t'
                                    substitute dom(h, t') for t': t
                                    substitute \forall u' \forall v' (in(op(u', v'), h) \leftrightarrow in(u', t') \wedge \exists s' (seg(u', \psi, s') \wedge \phi(op(u', res(h, s')), v'))) for t': t
                                    deny in(x, s) {
                                      apply invoke rightward seg(u, \psi, s) for x
                                      connect \psi(x, u) \wedge in(u, t)
                                      apply invoke closed(t, \psi) for u, x
                                      connect rtcset(y, \psi, t) \wedge in(u, t) \wedge \psi(x, u)
                                      connect closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi)
                                      apply invoke rtcset_future_exclusion for X, \psi
                                      connect in( x , X ) \wedge \psi(y,x) \wedge rtcset( y , \psi , t )
                                      apply invoke \forall x_0 \forall z_0 \forall r_0 (in(x_0, X) \wedge \psi(z_0, x_0) \wedge rtcset(z_0, \psi, r_0) \to notin(x_0, r_0)) for x, y, t
                                      contradict in(x, t)
                                    }
                                    apply invoke adding_op_res for Z, s, x, q
                                    substitute \phi(op(u, res(adj(Z, op(x, q)), s)), v) for res(adj(Z, op(x, q)), s): res(Z, s)
                                    connect bigcup(Y, Z) \wedge in(h, Y)
                                    apply invoke bigcup_subset for Y, Z, h
                                    connect closed(X, \psi) \wedge in(y, X) \wedge rtcset(y, \psi, t)
                                    apply invoke closed_implies_rtcset_is_subset for X, \psi, y, t
                                    connect closed(t, \psi) \wedge in(u, t) \wedge seg(u, \psi, s)
                                    apply invoke closed_implies_seg_is_subset for y, \psi, t, u, s
                                    connect fun(h) \wedge fun(Z) \wedge subset(h, Z) \wedge dom(h, t) \wedge subset(s, t)
                                    apply invoke res_subset_equality for h, Z, t, s
                                    substitute \phi(op(u, res(Z, s)), v) for res(Z, s): res(h, s)
                                    connect seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)
                                    lift for s conclude \exists s' (seg(u, \psi, s') \wedge \phi(op(u, res(h, s')), v))
                                    connect in(u, t) \wedge \exists s' (seg(u, \psi, s') \wedge \phi(op(u, res(h, s')), v))
                                    apply invoke leftward \forall u' \forall v' (in(op(u', v'), h) \leftrightarrow in(u', t) \wedge \exists s' (seg(u', \psi, s') \wedge \phi(op(u', res(h, s')), v'))) for u, v
                                    connect in(op(u, v), h) \wedge in(h, Y)
                                    lift for h conclude \exists h' (in(op(u, v), h') \wedge in(h', Y))
                                    apply invoke leftward bigcup(Y, Z) for op(u, v)
                                    apply invoke adj_cor1 for Z, op(x, q), op(u, v)
                                  }
                                }
                              }
                            }
                        }
                      }
                      connect in(op(u, v), adj(Z, op(x, q))) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v))
                    }
                    connect dom(adj(Z, op(x, q)), r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), adj(Z, op(x, q))) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v)))
                    lift for r conclude \exists r (dom(adj(Z, op(x, q)), r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), adj(Z, op(x, q))) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(adj(Z, op(x, q)), s)), v))))
                    connect approx(\psi, \phi, x, adj(Z, op(x, q)))
                    connect finite(adj(Z, op(x, q))) \wedge approx(\psi, \phi, x, adj(Z, op(x, q)))
                    lift for adj(Z, op(x, q)) conclude \exists h (finite(h) \wedge approx(\psi, \phi, x, h))
                  }
                }
              }
            }
          }
        }
      }
      connect closed( X , \psi ) \wedge irrefrel( X , \psi ) \wedge wellfounded( X , \psi ) \wedge \forall x_0 (in( x_0 , X ) \to (\forall y (\psi(y,x_0) \to \exists h (finite(h) \wedge approx( \psi , \phi , y , h ))) \to \exists h (finite(h) \wedge approx( \psi , \phi , x_0 , h ))))
      apply invoke wellfounded_induction for \psi, \lambda^P x. \exists h (finite(h) \wedge approx(\psi, \phi, x, h)), X
    }
  }
}
