include "zfc_finite_recursion.proof"

definition predicate hfcore(x, predicate \psi[2]) as \exists t (finite(t) \wedge tcset(x, \psi, t))

theorem element_of_hfcore_is_hfcore \forall x \forall^P \psi[2] \forall y (hfcore(x, \psi) \wedge \psi(y, x) \to hfcore(y, \psi)) {
  any x, predicate \psi[2], y {
    assume hfcore(x, \psi) \wedge \psi(y, x) {
      split hfcore(x, \psi) \wedge \psi(y, x)
      some t such hfcore(x, \psi) {
        split finite(t) \wedge tcset(x, \psi, t)
        connect tcset(x, \psi, t) \wedge \psi(y, x)
        apply invoke tcset_of_element_is_subset_of_tcset for x, \psi, t, y
        some s such \exists s (subset(s, t) \wedge tcset(y, \psi, s)) {
          split subset(s, t) \wedge tcset(y, \psi, s)
          connect finite(t) \wedge subset(s, t)
          apply invoke subset_of_finite_is_finite for t, s
          connect finite(s) \wedge tcset(y, \psi, s)
          lift for s conclude hfcore(y, \psi)
        }
      }
    }
  }
}

definition predicate hf(x, predicate \psi[2]) as regular(x, \psi) \wedge hfcore(x, \psi)

theorem element_of_hf_is_hf \forall x \forall^P \psi[2] \forall y (hf(x, \psi) \wedge \psi(y, x) \to hf(y, \psi)) {
  any x, predicate \psi[2], y {
    assume hf(x, \psi) \wedge \psi(y, x) {
      split hf(x, \psi) \wedge \psi(y, x)
      split hf(x, \psi)
      connect regular(x, \psi) \wedge \psi(y, x)
      apply invoke element_of_regular_is_regular for x, \psi, y
      connect hfcore(x, \psi) \wedge \psi(y, x)
      apply invoke element_of_hfcore_is_hfcore for x, \psi, y
      connect hf(y, \psi)
    }
  }
}

theorem hf_iff_existence_of_irrefrel_wellfounded_finite_tcset \forall x \forall^P \psi[2] (hf(x, \psi) \leftrightarrow \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t))) {
  any x, predicate \psi[2] {
    assume hf(x, \psi) {
      split hf(x, \psi)
      apply invoke rightward regular_iff_existence_of_irrefrel_wellfounded_tcset for x, \psi
      some t such \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge tcset(x, \psi, t)) {
        split irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge tcset(x, \psi, t)
        some t' such hfcore(x, \psi) {
          split finite(t') \wedge tcset(x, \psi, t')
          connect tcset(x, \psi, t) \wedge tcset(x, \psi, t')
          apply invoke tcset_is_unique for x, \psi, t, t'
          substitute finite(t') for t': t
          connect irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t)
          lift for t conclude \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t))
        }
      }
    }
    assume \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t)) {
      some t such \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t)) {
        split irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t)
        connect irrefrel(t, \psi) \wedge tcset(x, \psi, t)
        lift for t conclude hirrefrel(x, \psi)
        connect wellfounded(t, \psi) \wedge tcset(x, \psi, t)
        lift for t conclude hwellfounded(x, \psi)
        connect regular(x, \psi)
        connect finite(t) \wedge tcset(x, \psi, t)
        lift for t conclude hfcore(x, \psi)
        connect hf(x, \psi)
      }
    }
    connect hf(x, \psi) \leftrightarrow \exists t (irrefrel(t, \psi) \wedge wellfounded(t, \psi) \wedge finite(t) \wedge tcset(x, \psi, t))
  }
}

theorem hf_is_psubset_of_regular \forall^P \psi[2] (psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))) {
  any predicate \psi[2] {
    any x {
      assume hf(x, \psi) {
        split 1 hf(x, \psi)
      }
    }
    fold for psubset conclude psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
  }
}

theorem hf_is_pirrefrel \forall^P \psi[2] (pirrefrel(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_pirrefrel for \psi
    apply hf_is_psubset_of_regular for \psi
    connect pirrefrel(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_pirrefrel_is_pirrefrel for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_is_pwellfounded \forall^P \psi[2] (pwellfounded(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_pwellfounded for \psi
    apply hf_is_psubset_of_regular for \psi
    connect pwellfounded(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_pwellfounded_is_pwellfounded for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_is_pclosed \forall^P \psi[2] (pclosed(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    any x, y {
      assume hf(x, \psi) \wedge \psi(y, x) {
        apply invoke element_of_hf_is_hf for x, \psi, y
      }
    }
    fold for pclosed conclude pclosed(\lambda^P x. hf(x, \psi), \psi)
  }
}

theorem hf_is_tcsetlike \forall^P \psi[2] (tcsetlike(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_tcsetlike for \psi
    apply hf_is_psubset_of_regular for \psi
    connect tcsetlike(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_tcsetlike_is_tcsetlike for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_induction \forall^P \psi[2] (\forall^P \chi[1] (\forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x)) \to \forall x (hf(x, \psi) \to \chi(x)))) {
  any predicate \psi[2] {
    apply hf_is_pirrefrel for \psi
    apply hf_is_pwellfounded for \psi
    apply hf_is_pclosed for \psi
    apply hf_is_tcsetlike for \psi
    apply invoke tcsetlike_implies_rtcsetlike for \lambda^P x. hf(x, \psi), \psi
    any predicate \chi[1] {
      assume \forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x)) {
        connect rtcsetlike(\lambda^P x. hf(x, \psi), \psi) \wedge pclosed(\lambda^P x. hf(x, \psi), \psi) \wedge pirrefrel(\lambda^P x. hf(x, \psi), \psi) \wedge pwellfounded(\lambda^P x. hf(x, \psi), \psi) \wedge \forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x))
        apply invoke pwellfounded_induction for \lambda^P x. hf(x, \psi), \psi, \chi
      }
    }
  }
}
