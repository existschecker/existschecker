include "zfc_tc.proof"

definition predicate tcsetacc(X, predicate \psi[2], Y) as \forall y (in(y, Y) \leftrightarrow tc(\lambda^P p, q. \psi(q, p), X, y))

theorem piterate_closed_dest \forall n \forall^P \psi[2] \forall c \forall y \forall s (natural(n) \wedge closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s)) {
  any predicate \psi[2], c, y, s {
    assume closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), emptyset, c, y) {
      split closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), emptyset, c, y)
      apply invoke piterate_is_unique_base_step for \lambda^P p, q. \psi(q, p), c, y
      substitute in(c, s) for c: y
    }
  }
  any n {
    assume natural(n) {
      assume \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s)) {
        any predicate \psi[2], c, y, s {
          assume closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(n), c, y) {
            split closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(n), c, y)
            connect natural(n) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(n), c, y)
            apply invoke piterate_first_step for \lambda^P p, q. \psi(q, p), n, c, y
            some x such \exists x (piterate(\lambda^P p, q. \psi(q, p), n, x, y) \wedge \psi(x, c)) {
              split piterate(\lambda^P p, q. \psi(q, p), n, x, y) \wedge \psi(x, c)
              connect \psi(x, c) \wedge in(c, s)
              apply invoke closed(s, \psi) for c, x
              connect closed(s, \psi) \wedge in(x, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, x, y)
              apply invoke \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s)) for \psi, x, y, s
            }
          }
        }
      }
    }
  }
  connect \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), emptyset, c, y) \to in(y, s)) \wedge \forall n (natural(n) \to (\forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s)) \to \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(n), c, y) \to in(y, s)) ))
  apply invoke natural_induction for \lambda^P n. \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s))
  any n, predicate \psi[2], c, y, s {
    assume natural(n) \wedge closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) {
      split natural(n) \wedge closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y)
      apply invoke \forall n (natural(n) \to \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s))) for n
      connect closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y)
      apply invoke \forall^P \psi[2] \forall c \forall y \forall s (closed(s, \psi) \wedge in(c, s) \wedge piterate(\lambda^P p, q. \psi(q, p), n, c, y) \to in(y, s)) for \psi, c, y, s
    }
  }
}

theorem tcsetacc_implies_tcset \forall X \forall^P \psi[2] \forall Y (tcsetacc(X, \psi, Y) \to tcset(X, \psi, Y)) {
  any X, predicate \psi[2], Y {
    assume tcsetacc(X, \psi, Y) {
      any y, z {
        assume in(y, Y) \wedge \psi(z, y) {
          split in(y, Y) \wedge \psi(z, y)
          apply invoke rightward tcsetacc(X, \psi, Y) for y
          connect tc(\lambda^P p, q. \psi(q, p), X, y) \wedge \psi(z, y)
          apply invoke tc_add_last for \lambda^P p, q. \psi(q, p), X, y, z
          apply invoke leftward tcsetacc(X, \psi, Y) for z
        }
      }
      fold for closed conclude closed(Y, \psi)
      any x {
        assume \psi(x, X) {
          apply invoke tc_one_step for \lambda^P p, q. \psi(q, p), X, x
          apply invoke leftward tcsetacc(X, \psi, Y) for x
        }
      }
      any s {
        assume closed(s, \psi) \wedge \forall x (\psi(x, X) \to in(x, s)) {
          split closed(s, \psi) \wedge \forall x (\psi(x, X) \to in(x, s))
          any y {
            assume in(y, Y) {
              apply invoke rightward tcsetacc(X, \psi, Y) for y
              some n such tc(\lambda^P p, q. \psi(q, p), X, y) {
                split pnatural(n) \wedge piterate(\lambda^P p, q. \psi(q, p), n, X, y)
                apply invoke pnatural_is_suc_of_natural_element for n
                some m such \exists m (equal(n, suc(m)) \wedge in(m, n) \wedge natural(m)) {
                  split equal(n, suc(m)) \wedge in(m, n) \wedge natural(m)
                  substitute piterate(\lambda^P p, q. \psi(q, p), n, X, y) for n: suc(m)
                  connect natural(m) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(m), X, y)
                  apply invoke piterate_first_step for \lambda^P p, q. \psi(q, p), m, X, y
                  some x such \exists x (\psi(x, X) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)) {
                    split \psi(x, X) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)
                    apply invoke \forall x (\psi(x, X) \to in(x, s)) for x
                    connect natural(m) \wedge closed(s, \psi) \wedge in(x, s) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)
                    apply invoke piterate_closed_dest for m, \psi, x, y, s
                  }
                }
              }
            }
          }
          fold for subset conclude subset(Y, s)
        }
      }
      connect tcset(X, \psi, Y)
    }
  }
}

theorem tcset_implies_tcsetacc \forall X \forall^P \psi[2] \forall Y (tcset(X, \psi, Y) \to tcsetacc(X, \psi, Y)) {
  any X, predicate \psi[2], Y {
    assume tcset(X, \psi, Y) {
      split tcset(X, \psi, Y)
      any y {
        assume in(y, Y) {
          apply axiom_of_separation for Y, \lambda^P z. tc(\lambda^P p, q. \psi(q, p), X, z)
          some s such \exists s \forall z (in(z, s) \leftrightarrow in(z, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, z)) {
            any u, v {
              assume in(u, s) \wedge \psi(v, u) {
                split in(u, s) \wedge \psi(v, u)
                apply invoke rightward \forall z (in(z, s) \leftrightarrow in(z, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, z)) for u
                split in(u, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, u)
                connect in(u, Y) \wedge \psi(v, u)
                apply invoke closed(Y, \psi) for u, v
                connect tc(\lambda^P p, q. \psi(q, p), X, u) \wedge \psi(v, u)
                apply invoke tc_add_last for \lambda^P p, q. \psi(q, p), X, u, v
                connect in(v, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, v)
                apply invoke leftward \forall z (in(z, s) \leftrightarrow in(z, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, z)) for v
              }
            }
            fold for closed conclude closed(s, \psi)
            any x {
              assume \psi(x, X) {
                apply invoke \forall x (\psi(x, X) \to in(x, Y)) for x
                apply invoke tc_one_step for \lambda^P p, q. \psi(q, p), X, x
                connect in(x, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, x)
                apply invoke leftward \forall z (in(z, s) \leftrightarrow in(z, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, z)) for x
              }
            }
            connect closed(s, \psi) \wedge \forall x (\psi(x, X) \to in(x, s))
            apply invoke \forall s (closed(s, \psi) \wedge \forall x (\psi(x, X) \to in(x, s)) \to subset(Y, s)) for s
            apply invoke subset(Y, s) for y
            apply invoke rightward \forall z (in(z, s) \leftrightarrow in(z, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, z)) for y
            split 2 in(y, Y) \wedge tc(\lambda^P p, q. \psi(q, p), X, y)
          }
        }
        assume tc(\lambda^P p, q. \psi(q, p), X, y) {
          some n such tc(\lambda^P p, q. \psi(q, p), X, y) {
            split pnatural(n) \wedge piterate(\lambda^P p, q. \psi(q, p), n, X, y)
            apply invoke pnatural_is_suc_of_natural_element for n
            some m such \exists m (equal(n, suc(m)) \wedge in(m, n) \wedge natural(m)) {
              split equal(n, suc(m)) \wedge in(m, n) \wedge natural(m)
              substitute piterate(\lambda^P p, q. \psi(q, p), n, X, y) for n: suc(m)
              connect natural(m) \wedge piterate(\lambda^P p, q. \psi(q, p), suc(m), X, y)
              apply invoke piterate_first_step for \lambda^P p, q. \psi(q, p), m, X, y
              some x such \exists x (\psi(x, X) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)) {
                split \psi(x, X) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)
                apply invoke \forall x (\psi(x, X) \to in(x, Y)) for x
                connect natural(m) \wedge closed(Y, \psi) \wedge in(x, Y) \wedge piterate(\lambda^P p, q. \psi(q, p), m, x, y)
                apply invoke piterate_closed_dest for m, \psi, x, y, Y
              }
            }
          }
        }
        connect in(y, Y) \leftrightarrow tc(\lambda^P p, q. \psi(q, p), X, y)
      }
      fold for tcsetacc conclude tcsetacc(X, \psi, Y)
    }
  }
}

theorem tcset_iff_tcsetacc \forall X \forall^P \psi[2] \forall Y (tcset(X, \psi, Y) \leftrightarrow tcsetacc(X, \psi, Y)) {
  any X, predicate \psi[2], Y {
    apply tcset_implies_tcsetacc for X, \psi, Y
    apply tcsetacc_implies_tcset for X, \psi, Y
    connect tcset(X, \psi, Y) \leftrightarrow tcsetacc(X, \psi, Y)
  }
}
