include "zfc_function.proof"

definition function res(R, X) as sep(R, \lambda^P z. \exists x \exists y (in(x, X) \wedge equal(z, op(x, y))))

theorem res_characterization \forall R \forall X \forall z (in(z, res(R, X)) \leftrightarrow in(z, R) \wedge \exists x \exists y (in(x, X) \wedge equal(z, op(x, y)))) {
  any R, X, z {
    assume in(z, res(R, X)) {
      expand in(z, res(R, X)) for res
      apply invoke rightward sep_existence for R, \lambda^P z. \exists x \exists y (in(x, X) \wedge equal(z, op(x, y))), z
    }
    assume in(z, R) \wedge \exists x \exists y (in(x, X) \wedge equal(z, op(x, y))) {
      apply invoke leftward sep_existence for R, \lambda^P z. \exists x \exists y (in(x, X) \wedge equal(z, op(x, y))), z
      fold for res conclude in(z, res(R, X))
    }
    connect in(z, res(R, X)) \leftrightarrow in(z, R) \wedge \exists x \exists y (in(x, X) \wedge equal(z, op(x, y)))
  }
}

theorem adding_op_res \forall R \forall X \forall x \forall y (notin(x, X) \to equal(res(adj(R, op(x, y)), X), res(R, X))) {
  any R, X, x, y {
    assume notin(x, X) {
      any z {
        assume in(z, res(adj(R, op(x, y)), X)) {
          expand in(z, res(adj(R, op(x, y)), X)) for res
          apply invoke rightward sep_existence for adj(R, op(x, y)), \lambda^P z'. \exists x' \exists y' (in(x', X) \wedge equal(z', op(x', y'))), z
          split in(z, adj(R, op(x, y))) \wedge \exists x' \exists y' (in(x', X) \wedge equal(z, op(x', y')))
          some x', y' such \exists x' \exists y' (in(x', X) \wedge equal(z, op(x', y'))) {
            split in(x', X) \wedge equal(z, op(x', y'))
            apply invoke rightward adj_existence for R, op(x, y), z
            divide in(z, R) \vee equal(z, op(x, y))
              case in(z, R) {}
              case equal(z, op(x, y)) {
                substitute equal(z, op(x', y')) for z: op(x, y)
                apply invoke op_characterization for x, y, x', y'
                split equal(x, x') \wedge equal(y, y')
                substitute in(x', X) for x': x
                contradict in(x, X)
                explode in(z, R)
              }
            connect in(z, R) \wedge \exists x' \exists y' (in(x', X) \wedge equal(z, op(x', y')))
            apply invoke leftward sep_existence for R, \lambda^P z'. \exists x' \exists y' (in(x', X) \wedge equal(z', op(x', y'))), z
            fold for res conclude in(z, res(R, X))
          }
        }
        assume in(z, res(R, X)) {
          expand in(z, res(R, X)) for res
          apply invoke rightward sep_existence for R, \lambda^P z'. \exists x' \exists y' (in(x', X) \wedge equal(z', op(x', y'))), z
          split in(z, R) \wedge \exists x' \exists y' (in(x', X) \wedge equal(z, op(x', y')))
          apply invoke adj_cor1 for R, op(x, y), z
          connect in(z, adj(R, op(x, y))) \wedge \exists x' \exists y' (in(x', X) \wedge equal(z, op(x', y')))
          apply invoke leftward sep_existence for adj(R, op(x, y)), \lambda^P z'. \exists x' \exists y' (in(x', X) \wedge equal(z', op(x', y'))), z
          fold for res conclude in(z, res(adj(R, op(x, y)), X))
        }
        connect in(z, res(adj(R, op(x, y)), X)) \leftrightarrow in(z, res(R, X))
      }
      apply invoke axiom_of_extensionality for res(adj(R, op(x, y)), X), res(R, X)
    }
  }
}

theorem res_subset_equality \forall h \forall Z \forall t \forall s (fun(h) \wedge fun(Z) \wedge subset(h, Z) \wedge dom(h, t) \wedge subset(s, t) \to equal(res(h, s), res(Z, s))) {
  any h, Z, t, s {
    assume fun(h) \wedge fun(Z) \wedge subset(h, Z) \wedge dom(h, t) \wedge subset(s, t) {
      split fun(h) \wedge fun(Z) \wedge subset(h, Z) \wedge dom(h, t) \wedge subset(s, t)
      any z {
        assume in(z, res(h, s)) {
          apply invoke rightward res_characterization for h, s, z
          split in(z, h) \wedge \exists x \exists y (in(x, s) \wedge equal(z, op(x, y)))
          apply invoke subset(h, Z) for z
          some x, y such \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))) {
            split in(x, s) \wedge equal(z, op(x, y))
            substitute in(z, Z) for z: op(x, y)
            connect in(x, s) \wedge equal(z, op(x, y))
            lift for x, y conclude \exists x \exists y (in(x, s) \wedge equal(z, op(x, y)))
            connect in(z, Z) \wedge \exists x \exists y (in(x, s) \wedge equal(z, op(x, y)))
            apply invoke leftward res_characterization for Z, s, z
          }
        }
        assume in(z, res(Z, s)) {
          apply invoke rightward res_characterization for Z, s, z
          split in(z, Z) \wedge \exists x \exists y (in(x, s) \wedge equal(z, op(x, y)))
          some x, y such \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))) {
            split in(x, s) \wedge equal(z, op(x, y))
            substitute in(z, Z) for z: op(x, y)
            apply invoke subset(s, t) for x
            apply invoke rightward dom(h, t) for x
            some y' such \exists y' (in(op(x, y'), h)) {
              apply invoke subset(h, Z) for op(x, y')
              split fun(Z)
              connect in(op(x, y), Z) \wedge in(op(x, y'), Z)
              apply invoke \forall x \forall y \forall y' (in(op(x, y), Z) \wedge in(op(x, y'), Z) \to equal(y, y')) for x, y, y'
              substitute in(op(x, y'), h) for y': y
              substitute in(op(x, y), h) for op(x, y): z
              connect in(z, h) \wedge \exists x \exists y (in(x, s) \wedge equal(z, op(x, y)))
              apply invoke leftward res_characterization for h, s, z
            }
          }
        }
        connect in(z, res(h, s)) \leftrightarrow in(z, res(Z, s))
      }
      apply invoke axiom_of_extensionality for res(h, s), res(Z, s)
    }
  }
}

definition predicate approx(predicate \psi[2], predicate \phi[2], x, h) as fun(h) \wedge \exists r (dom(h, r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v))))

theorem approx_is_unique \forall X \forall^P \psi[2] \forall^P \phi[2] (closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi) \to \forall x \forall y \forall g \forall h (in(x, X) \wedge approx(\psi, \phi, x, g) \wedge in(y, X) \wedge approx(\psi, \phi, y, h) \to \forall u \forall v \forall v' (in(op(u, v), g) \wedge in(op(u, v'), h) \to equal(v, v')))) {
  any X, predicate \psi[2], predicate \phi[2] {
    assume closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi) {
      split closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi)
      any x, y, g, h {
        assume in(x, X) \wedge approx(\psi, \phi, x, g) \wedge in(y, X) \wedge approx(\psi, \phi, y, h) {
          split in(x, X) \wedge approx(\psi, \phi, x, g) \wedge in(y, X) \wedge approx(\psi, \phi, y, h)
          split approx(\psi, \phi, x, g)
          some r such \exists r (dom(g, r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), g) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(g, s)), v)))) {
            split dom(g, r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), g) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(g, s)), v)))
            split rtcset(x, \psi, r)
            connect closed(X, \psi) \wedge in(x, X) \wedge rtcset(x, \psi, r)
            apply invoke closed_implies_rtcset_is_subset for X, \psi, x, r
            split approx(\psi, \phi, y, h)
            some t such \exists t (dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))) {
              split dom(h, t) \wedge rtcset(y, \psi, t) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))
              split rtcset(y, \psi, t)
              connect closed(r, \psi) \wedge closed(t, \psi)
              apply invoke cap_of_closed_is_closed for r, t, \psi
              apply cap_is_subset_left for r, t
              connect subset(cap(r, t), r) \wedge subset(r, X)
              apply invoke subset_transivity for cap(r, t), r, X
              connect irrefrel(X, \psi) \wedge subset(cap(r, t), X)
              apply invoke subset_of_irrefrel_is_irrefrel for \psi, X, cap(r, t)
              connect wellfounded(X, \psi) \wedge subset(cap(r, t), X)
              apply invoke subset_of_wellfounded_is_wellfounded for \psi, X, cap(r, t)
              apply sep_is_subset for cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
              connect subset(sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), cap(r, t)) \wedge subset(cap(r, t), X)
              apply invoke subset_transivity for sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), cap(r, t), X
              deny \exists u \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')) {
                some u, v, v' such \exists u \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')) {
                  split in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')
                  lift for v conclude \exists v (in(op(u, v), g))
                  apply invoke leftward dom(g, r) for u
                  apply invoke subset(r, X) for u
                  lift for v' conclude \exists v' (in(op(u, v'), h))
                  apply invoke leftward dom(h, t) for u
                  connect in(u, r) \wedge in(u, t)
                  apply invoke leftward cap_characterization for r, t, u
                  lift for v, v' conclude \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
                  connect in(u, cap(r, t)) \wedge \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
                  apply invoke leftward sep_existence for cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')), u
                  lift for u conclude \exists u (in(u, sep(cap(r, t), \lambda^P u'. \exists v \exists v' (in(op(u', v), g) \wedge in(op(u', v'), h) \wedge neq(v, v')))))
                }
                apply invoke has_a_member_not_emptyset for sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')))
                connect subset(sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), X) \wedge neq(sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), emptyset)
                apply invoke wellfounded(X, \psi) for sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')))
                some a such \exists a (minimal(\psi, sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), a)) {
                  split minimal(\psi, sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), a)
                  apply invoke rightward sep_existence for cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')), a
                  split in(a, cap(r, t)) \wedge \exists v \exists v' (in(op(a, v), g) \wedge in(op(a, v'), h) \wedge neq(v, v'))
                  some v, v' such \exists v \exists v' (in(op(a, v), g) \wedge in(op(a, v'), h) \wedge neq(v, v')) {
                    split in(op(a, v), g) \wedge in(op(a, v'), h) \wedge neq(v, v')
                    any z {
                      assume \psi(z, a) {
                        connect in(a, cap(r, t)) \wedge \psi(z, a)
                        apply invoke closed(cap(r, t), \psi) for a, z
                        apply invoke rightward cap_characterization for r, t, z
                        split in(z, r) \wedge in(z, t)
                        apply invoke rightward dom(g, r) for z
                        some w such \exists w (in(op(z, w), g)) {
                          apply invoke rightward dom(h, t) for z
                          some w' such \exists w' (in(op(z, w'), h)) {
                            deny \exists v \exists v' (in(op(z, v), g) \wedge in(op(z, v'), h) \wedge neq(v, v')) {
                              connect in(a, cap(r, t)) \wedge \psi(z, a)
                              apply invoke closed(cap(r, t), \psi) for a, z
                              connect in(z, cap(r, t)) \wedge \exists v \exists v' (in(op(z, v), g) \wedge in(op(z, v'), h) \wedge neq(v, v'))
                              apply invoke leftward sep_existence for cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')), z
                              deny equal(z, a) {
                                substitute \psi(z, a) for z: a
                                apply invoke irrefrel(cap(r, t), \psi) for a
                                contradict \psi(a, a)
                              }
                              connect in(z, sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')))) \wedge neq(z, a)
                              apply invoke minimal_core(\psi, sep(cap(r, t), \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))), a) for z
                              contradict \psi(z, a)
                            }
                            apply invoke rightward neg_exist_leftrightarrow_forall_neg for \lambda^P v. \exists v' (in(op(z, v), g) \wedge in(op(z, v'), h) \wedge neq(v, v'))
                            apply \forall v (\neg(\exists v' (in(op(z, v), g) \wedge in(op(z, v'), h) \wedge neq(v, v')))) for w
                            apply invoke rightward neg_exist_leftrightarrow_forall_neg for \lambda^P v'. in(op(z, w), g) \wedge in(op(z, v'), h) \wedge neq(w, v')
                            apply \forall v' (\neg(in(op(z, w), g) \wedge in(op(z, v'), h) \wedge neq(w, v'))) for w'
                            deny neq(w, w') {
                              connect in(op(z, w), g) \wedge in(op(z, w'), h) \wedge neq(w, w')
                              contradict in(op(z, w), g) \wedge in(op(z, w'), h) \wedge neq(w, w')
                            }
                            substitute in(op(z, w'), h) for w': w
                          }
                          connect in(op(z, w), g) \wedge in(op(z, w), h)
                          lift for w conclude \exists w (in(op(z, w), g) \wedge in(op(z, w), h))
                        }
                      }
                    }
                    apply invoke rightward \forall u \forall v (in(op(u, v), g) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(g, s)), v))) for a, v
                    split in(a, r) \wedge \exists s (seg(a, \psi, s) \wedge \phi(op(a, res(g, s)), v))
                    some s such \exists s (seg(a, \psi, s) \wedge \phi(op(a, res(g, s)), v)) {
                      split seg(a, \psi, s) \wedge \phi(op(a, res(g, s)), v)
                      apply invoke rightward \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, t) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v))) for a, v'
                      split in(a, t) \wedge \exists s (seg(a, \psi, s) \wedge \phi(op(a, res(h, s)), v'))
                      some s' such \exists s' (seg(a, \psi, s') \wedge \phi(op(a, res(h, s')), v')) {
                        split seg(a, \psi, s') \wedge \phi(op(a, res(h, s')), v')
                        connect seg(a, \psi, s) \wedge seg(a, \psi, s')
                        apply invoke seg_is_unique for a, \psi, s, s'
                        substitute \phi(op(a, res(h, s')), v') for s': s
                      }
                      any p {
                        assume in(p, res(g, s)) {
                          expand in(p, res(g, s)) for res
                          apply invoke rightward sep_existence for g, \lambda^P z. \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))), p
                          split in(p, g) \wedge \exists x \exists y (in(x, s) \wedge equal(p, op(x, y)))
                          some z, w such \exists x \exists y (in(x, s) \wedge equal(p, op(x, y))) {
                            split in(z, s) \wedge equal(p, op(z, w))
                            substitute in(p, g) for p: op(z, w)
                            apply invoke rightward seg(a, \psi, s) for z
                            apply invoke \forall z (\psi(z, a) \to \exists w (in(op(z, w), g) \wedge in(op(z, w), h))) for z
                            some w' such \exists w' (in(op(z, w'), g) \wedge in(op(z, w'), h)) {
                              split in(op(z, w'), g) \wedge in(op(z, w'), h)
                              connect in(op(z, w), g) \wedge in(op(z, w'), g)
                              split fun(g)
                              apply invoke \forall x \forall y \forall y' (in(op(x, y), g) \wedge in(op(x, y'), g) \to equal(y, y')) for z, w, w'
                              substitute in(op(z, w'), h) for w': w
                            }
                            substitute in(op(z, w), h) for op(z, w): p
                          }
                          connect in(p, h) \wedge \exists x \exists y (in(x, s) \wedge equal(p, op(x, y)))
                          apply invoke leftward sep_existence for h, \lambda^P z. \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))), p
                          fold for res conclude in(p, res(h, s))
                        }
                        assume in(p, res(h, s)) {
                          expand in(p, res(h, s)) for res
                          apply invoke rightward sep_existence for h, \lambda^P z. \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))), p
                          split in(p, h) \wedge \exists x \exists y (in(x, s) \wedge equal(p, op(x, y)))
                          some z, w such \exists x \exists y (in(x, s) \wedge equal(p, op(x, y))) {
                            split in(z, s) \wedge equal(p, op(z, w))
                            substitute in(p, h) for p: op(z, w)
                            apply invoke rightward seg(a, \psi, s) for z
                            apply invoke \forall z (\psi(z, a) \to \exists w (in(op(z, w), g) \wedge in(op(z, w), h))) for z
                            some w' such \exists w' (in(op(z, w'), g) \wedge in(op(z, w'), h)) {
                              split in(op(z, w'), g) \wedge in(op(z, w'), h)
                              connect in(op(z, w), h) \wedge in(op(z, w'), h)
                              split fun(h)
                              apply invoke \forall x \forall y \forall y' (in(op(x, y), h) \wedge in(op(x, y'), h) \to equal(y, y')) for z, w, w'
                              substitute in(op(z, w'), g) for w': w
                            }
                            substitute in(op(z, w), g) for op(z, w): p
                          }
                          connect in(p, g) \wedge \exists x \exists y (in(x, s) \wedge equal(p, op(x, y)))
                          apply invoke leftward sep_existence for g, \lambda^P z. \exists x \exists y (in(x, s) \wedge equal(z, op(x, y))), p
                          fold for res conclude in(p, res(g, s))
                        }
                        connect in(p, res(g, s)) \leftrightarrow in(p, res(h, s))
                      }
                      apply invoke axiom_of_extensionality for res(g, s), res(h, s)
                      substitute \phi(op(a, res(h, s)), v') for res(h, s): res(g, s)
                      connect \phi(op(a, res(g, s)), v) \wedge \phi(op(a, res(g, s)), v')
                      apply invoke functional(\phi) for op(a, res(g, s)), v, v'
                    }
                    contradict equal(v, v')
                  }
                }
              }
              apply invoke rightward neg_exist_leftrightarrow_forall_neg for \lambda^P u. \exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
              any u {
                apply \forall u (\neg(\exists v \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')))) for u
                apply invoke rightward neg_exist_leftrightarrow_forall_neg for \lambda^P v. \exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
                any v {
                  apply \forall v (\neg(\exists v' (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')))) for v
                  apply invoke rightward neg_exist_leftrightarrow_forall_neg for \lambda^P v'. (in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))
                  any v' {
                    apply \forall v' (\neg(in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v'))) for v'
                    assume in(op(u, v), g) \wedge in(op(u, v'), h) {
                      split in(op(u, v), g) \wedge in(op(u, v'), h)
                      deny neq(v, v') {
                        connect in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')
                        contradict in(op(u, v), g) \wedge in(op(u, v'), h) \wedge neq(v, v')
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

theorem approx_is_functional \forall X \forall^P \psi[2] \forall^P \phi[2] (closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi) \to functional(\lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h))) {
  any X, predicate \psi[2], predicate \phi[2] {
    assume closed(X, \psi) \wedge irrefrel(X, \psi) \wedge wellfounded(X, \psi) \wedge functional(\phi) {
      apply invoke approx_is_unique for X, \psi, \phi
      any x, h, h' {
        assume in(x, X) \wedge approx(\psi, \phi, x, h) \wedge in(x, X) \wedge approx(\psi, \phi, x, h') {
          apply invoke \forall x \forall y \forall g \forall h (in(x, X) \wedge approx(\psi, \phi, x, g) \wedge in(y, X) \wedge approx(\psi, \phi, y, h) \to \forall u \forall v \forall v' (in(op(u, v), g) \wedge in(op(u, v'), h) \to equal(v, v'))) for x, x, h, h'
          split in(x, X) \wedge approx(\psi, \phi, x, h) \wedge in(x, X) \wedge approx(\psi, \phi, x, h')
          split approx(\psi, \phi, x, h)
          split fun(h)
          split approx(\psi, \phi, x, h')
          split fun(h')
          some r such \exists r (dom(h, r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v))) ) {
            split dom(h, r) \wedge rtcset(x, \psi, r) \wedge \forall u \forall v (in(op(u, v), h) \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h, s)), v)))
            some r' such \exists r' (dom(h', r') \wedge rtcset(x, \psi, r') \wedge \forall u \forall v (in(op(u, v), h') \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h', s)), v)))) {
              split dom(h', r') \wedge rtcset(x, \psi, r') \wedge \forall u \forall v (in(op(u, v), h') \leftrightarrow in(u, r) \wedge \exists s (seg(u, \psi, s) \wedge \phi(op(u, res(h', s)), v)))
              connect rtcset(x, \psi, r) \wedge rtcset(x, \psi, r')
              apply invoke rtcset_is_unique for x, \psi, r, r'
              substitute dom(h', r') for r': r
            }
            any z {
              assume in(z, h) {
                apply invoke rel(h) for z
                some u, v such \exists u \exists v (equal(z, op(u, v))) {
                  substitute in(z, h) for z: op(u, v)
                  lift for v conclude \exists v (in(op(u, v), h))
                  apply invoke leftward dom(h, r) for u
                  apply invoke rightward dom(h', r) for u
                  some v' such \exists v' (in(op(u, v'), h')) {
                    connect in(op(u, v), h) \wedge in(op(u, v'), h')
                    apply invoke \forall u \forall v \forall v' (in(op(u, v), h) \wedge in(op(u, v'), h') \to equal(v, v')) for u, v, v'
                    substitute in(op(u, v'), h') for v': v
                  }
                  substitute in(op(u, v), h') for op(u, v): z
                }
              }
              assume in(z, h') {
                apply invoke rel(h') for z
                some u, v' such \exists u \exists v' (equal(z, op(u, v'))) {
                  substitute in(z, h') for z: op(u, v')
                  lift for v' conclude \exists v' (in(op(u, v'), h'))
                  apply invoke leftward dom(h', r) for u
                  apply invoke rightward dom(h, r) for u
                  some v such \exists v (in(op(u, v), h)) {
                    connect in(op(u, v), h) \wedge in(op(u, v'), h')
                    apply invoke \forall u \forall v \forall v' (in(op(u, v), h) \wedge in(op(u, v'), h') \to equal(v, v')) for u, v, v'
                    substitute in(op(u, v), h) for v: v'
                  }
                  substitute in(op(u, v'), h) for op(u, v'): z
                }
              }
              connect in(z, h) \leftrightarrow in(z, h')
            }
            apply invoke axiom_of_extensionality for h, h'
          }
        }
      }
      fold for functional conclude functional(\lambda^P y, h. in(y, X) \wedge approx(\psi, \phi, y, h))
    }
  }
}
