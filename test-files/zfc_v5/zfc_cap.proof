include "zfc_removal.proof"

theorem cap_exists_uniquely \forall x \forall y \exists! z \forall w (in(w, z) \leftrightarrow in(w, x) \wedge in(w, y)) {
  any x, y {
    apply separation_exists_uniquely for x, \lambda^P w. in(w, y)
    expand \exists! z (sep(x, \lambda^P w. in(w, y), z)) for sep
  }
}

definition function cap by cap_exists_uniquely tex infix "\cap"

theorem cap_is_subset_left \forall x \forall y (subset(cap(x, y), x)) {
  any x, y {
    any z {
      assume in(z, cap(x, y)) {
        apply invoke rightward cap.existence for x, y, z
        split 1 in(z, x) \wedge in(z, y)
      }
    }
    fold for subset conclude subset(cap(x, y), x)
  }
}

theorem cap_is_subset_right \forall x \forall y (subset(cap(x, y), y)) {
  any x, y {
    any z {
      assume in(z, cap(x, y)) {
        apply invoke rightward cap.existence for x, y, z
        split 2 in(z, x) \wedge in(z, y)
      }
    }
    fold for subset conclude subset(cap(x, y), y)
  }
}
