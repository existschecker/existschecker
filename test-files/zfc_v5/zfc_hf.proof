include "zfc_finite_recursion.proof"

definition predicate hfcore(x, predicate \psi[2]) as \exists t (finite(t) \wedge rtcset(x, \psi, t))

theorem element_of_hfcore_is_hfcore \forall x \forall^P \psi[2] \forall y (hfcore(x, \psi) \wedge \psi(y, x) \to hfcore(y, \psi)) {
  any x, predicate \psi[2], y {
    assume hfcore(x, \psi) \wedge \psi(y, x) {
      split hfcore(x, \psi) \wedge \psi(y, x)
      some t such hfcore(x, \psi) {
        split finite(t) \wedge rtcset(x, \psi, t)
        connect rtcset(x, \psi, t) \wedge \psi(y, x)
        apply invoke rtcset_of_element_is_subset_of_rtcset for x, \psi, t, y
        some s such \exists s (subset(s, t) \wedge rtcset(y, \psi, s)) {
          split subset(s, t) \wedge rtcset(y, \psi, s)
          connect finite(t) \wedge subset(s, t)
          apply invoke subset_of_finite_is_finite for t, s
          connect finite(s) \wedge rtcset(y, \psi, s)
          lift for s conclude hfcore(y, \psi)
        }
      }
    }
  }
}

theorem finite_generation_of_hfcore_is_hfcore \forall^P \psi[2] \forall Y (\exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hfcore(y, \psi)) \to hfcore(Y, \psi) \wedge \exists S \exists Z \exists W \exists V (rtcsetstep(\psi, Y, S, Z, W, V))) {
  any predicate \psi[2], Y {
    assume \exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hfcore(y, \psi)) {
      split \exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hfcore(y, \psi))
      any y, z, z' {
        assume rtcset(y, \psi, z) \wedge rtcset(y, \psi, z') {
          apply invoke rtcset_is_unique for y, \psi, z, z'
        }
      }
      fold for functional conclude functional(\lambda^P y, z. rtcset(y, \psi, z))
      some S such \exists S (finite(S) \wedge seg(Y, \psi, S)) {
        split finite(S) \wedge seg(Y, \psi, S)
        connect finite(S) \wedge functional(\lambda^P y, z. rtcset(y, \psi, z))
        apply invoke finite_replacement_exists_uniquely for S, \lambda^P y, z. rtcset(y, \psi, z)
        some Z such \exists! Z (finite(Z) \wedge replacement(S, \lambda^P y, z. rtcset(y, \psi, z), Z)) {
          split finite(Z) \wedge replacement(S, \lambda^P y, z. rtcset(y, \psi, z), Z)
          any z {
            assume in(z, Z) {
              apply invoke rightward replacement(S, \lambda^P y, z. rtcset(y, \psi, z), Z) for z
              some y such \exists y (in(y, S) \wedge rtcset(y, \psi, z)) {
                split in(y, S) \wedge rtcset(y, \psi, z)
                apply invoke rightward seg(Y, \psi, S) for y
                apply invoke \forall y (\psi(y, Y) \to hfcore(y, \psi)) for y
                some z' such hfcore(y, \psi) {
                  split finite(z') \wedge rtcset(y, \psi, z')
                  connect rtcset(y, \psi, z) \wedge rtcset(y, \psi, z')
                  apply invoke rtcset_is_unique for y, \psi, z, z'
                  substitute finite(z') for z': z
                }
              }
            }
          }
          connect finite(Z) \wedge \forall z (in(z, Z) \to finite(z))
          apply invoke finite_bigcup_exists_uniquely for Z
          some W such \exists! W (finite(W) \wedge bigcup(Z, W)) {
            split finite(W) \wedge bigcup(Z, W)
            connect finite(S) \wedge finite(W)
            apply invoke finite_cup_exists_uniquely for S, W
            any y {
              assume \psi(y, Y) {
                apply invoke \forall y (\psi(y, Y) \to hfcore(y, \psi)) for y
                some z such hfcore(y, \psi) {
                  split 2 finite(z) \wedge rtcset(y, \psi, z)
                  lift for z conclude \exists z (rtcset(y, \psi, z))
                }
              }
            }
            connect rtcsetstep(\psi,Y, S, Z, W, adj(W, Y))
            apply invoke rtcset_is_cup_of_itself_and_bigcup_of_rtcset_of_element for \psi, Y, S, Z, W, adj(W, Y)
            apply invoke finite_adj for W, Y
            connect finite(adj(W, Y)) \wedge rtcset(Y, \psi, adj(W, Y))
            lift for adj(W, Y) conclude hfcore(Y, \psi)
            lift for S, Z, W, adj(W, Y) conclude \exists S \exists Z \exists W \exists V (rtcsetstep(\psi, Y, S, Z, W, V))
            connect hfcore(Y, \psi) \wedge \exists S \exists Z \exists W \exists V (rtcsetstep(\psi, Y, S, Z, W, V))
          }
        }
      }
    }
  }
}

definition predicate hf(x, predicate \psi[2]) as regular(x, \psi) \wedge hfcore(x, \psi)

theorem element_of_hf_is_hf \forall x \forall^P \psi[2] \forall y (hf(x, \psi) \wedge \psi(y, x) \to hf(y, \psi)) {
  any x, predicate \psi[2], y {
    assume hf(x, \psi) \wedge \psi(y, x) {
      split hf(x, \psi) \wedge \psi(y, x)
      split hf(x, \psi)
      connect regular(x, \psi) \wedge \psi(y, x)
      apply invoke element_of_regular_is_regular for x, \psi, y
      connect hfcore(x, \psi) \wedge \psi(y, x)
      apply invoke element_of_hfcore_is_hfcore for x, \psi, y
      connect hf(y, \psi)
    }
  }
}

theorem finite_generation_of_hf_is_hf \forall^P \psi[2] \forall Y (\exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hf(y, \psi)) \to hf(Y, \psi)) {
  any predicate \psi[2], Y {
    assume \exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hf(y, \psi)) {
      split \exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hf(y, \psi))
      any y {
        assume \psi(y, Y) {
          apply invoke \forall y (\psi(y, Y) \to hf(y, \psi)) for y
          split 1 hf(y, \psi)
        }
      }
      any y {
        assume \psi(y, Y) {
          apply invoke \forall y (\psi(y, Y) \to hf(y, \psi)) for y
          split 2 hf(y, \psi)
        }
      }
      connect \exists S (finite(S) \wedge seg(Y, \psi, S)) \wedge \forall y (\psi(y, Y) \to hfcore(y, \psi))
      apply invoke finite_generation_of_hfcore_is_hfcore for \psi, Y
      split hfcore(Y, \psi) \wedge \exists S \exists Z \exists W \exists V (rtcsetstep(\psi, Y, S, Z, W, V))
      connect \forall y (\psi(y, Y) \to regular(y, \psi)) \wedge \exists S \exists Z \exists W \exists V (rtcsetstep(\psi, Y, S, Z, W, V))
      apply invoke generation_from_regular_is_regular for \psi, Y
      connect hf(Y, \psi)
    }
  }
}

theorem hf_iff_existence_of_irrefrel_wellfounded_finite_rtcset \forall x \forall^P \psi[2] (hf(x, \psi) \leftrightarrow \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r))) {
  any x, predicate \psi[2] {
    assume hf(x, \psi) {
      split hf(x, \psi)
      apply invoke rightward regular_iff_existence_of_irrefrel_wellfounded_rtcset for x, \psi
      some r such \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge rtcset(x, \psi, r)) {
        split irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge rtcset(x, \psi, r)
        some r' such hfcore(x, \psi) {
          split finite(r') \wedge rtcset(x, \psi, r')
          connect rtcset(x, \psi, r) \wedge rtcset(x, \psi, r')
          apply invoke rtcset_is_unique for x, \psi, r, r'
          substitute finite(r') for r': r
          connect irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r)
          lift for r conclude \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r))
        }
      }
    }
    assume \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r)) {
      some r such \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r)) {
        split irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r)
        connect irrefrel(r, \psi) \wedge rtcset(x, \psi, r)
        lift for r conclude hirrefrel(x, \psi)
        connect wellfounded(r, \psi) \wedge rtcset(x, \psi, r)
        lift for r conclude hwellfounded(x, \psi)
        connect regular(x, \psi)
        connect finite(r) \wedge rtcset(x, \psi, r)
        lift for r conclude hfcore(x, \psi)
        connect hf(x, \psi)
      }
    }
    connect hf(x, \psi) \leftrightarrow \exists r (irrefrel(r, \psi) \wedge wellfounded(r, \psi) \wedge finite(r) \wedge rtcset(x, \psi, r))
  }
}

theorem hf_is_psubset_of_regular \forall^P \psi[2] (psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))) {
  any predicate \psi[2] {
    any x {
      assume hf(x, \psi) {
        split 1 hf(x, \psi)
      }
    }
    fold for psubset conclude psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
  }
}

theorem hf_is_pirrefrel \forall^P \psi[2] (pirrefrel(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_pirrefrel for \psi
    apply hf_is_psubset_of_regular for \psi
    connect pirrefrel(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_pirrefrel_is_pirrefrel for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_is_pwellfounded \forall^P \psi[2] (pwellfounded(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_pwellfounded for \psi
    apply hf_is_psubset_of_regular for \psi
    connect pwellfounded(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_pwellfounded_is_pwellfounded for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_is_pclosed \forall^P \psi[2] (pclosed(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    any x, y {
      assume hf(x, \psi) \wedge \psi(y, x) {
        apply invoke element_of_hf_is_hf for x, \psi, y
      }
    }
    fold for pclosed conclude pclosed(\lambda^P x. hf(x, \psi), \psi)
  }
}

theorem hf_is_rtcsetlike \forall^P \psi[2] (rtcsetlike(\lambda^P x. hf(x, \psi), \psi)) {
  any predicate \psi[2] {
    apply regular_is_rtcsetlike for \psi
    apply hf_is_psubset_of_regular for \psi
    connect rtcsetlike(\lambda^P x. regular(x, \psi), \psi) \wedge psubset(\lambda^P x. hf(x, \psi), \lambda^P x. regular(x, \psi))
    apply invoke psubset_of_rtcsetlike_is_rtcsetlike for \lambda^P x. regular(x, \psi), \psi, \lambda^P x. hf(x, \psi)
  }
}

theorem hf_induction \forall^P \psi[2] (\forall^P \chi[1] (\forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x)) \to \forall x (hf(x, \psi) \to \chi(x)))) {
  any predicate \psi[2] {
    apply hf_is_pirrefrel for \psi
    apply hf_is_pwellfounded for \psi
    apply hf_is_pclosed for \psi
    apply hf_is_rtcsetlike for \psi
    any predicate \chi[1] {
      assume \forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x)) {
        connect rtcsetlike(\lambda^P x. hf(x, \psi), \psi) \wedge pclosed(\lambda^P x. hf(x, \psi), \psi) \wedge pirrefrel(\lambda^P x. hf(x, \psi), \psi) \wedge pwellfounded(\lambda^P x. hf(x, \psi), \psi) \wedge \forall x (hf(x, \psi) \wedge \forall y (\psi(y, x) \to \chi(y)) \to \chi(x))
        apply invoke pwellfounded_induction for \lambda^P x. hf(x, \psi), \psi, \chi
      }
    }
  }
}
